<Page x:Class="KosLis.OptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KosLis"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="OptionsPage">

    <Grid Margin="15">
        <StackPanel>
            <Grid VerticalAlignment="Center" Height="50">
                <Rectangle RadiusX="15" RadiusY="15" Fill="#252525" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Label Margin="15,0,0,0" VerticalAlignment="Center" Content="Запомнить данные для входа"/>
                    <CheckBox Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"/>
                </Grid>
            </Grid>
            <Grid Margin="0,5,0,0" VerticalAlignment="Center" Height="50">
                <Rectangle RadiusX="15" RadiusY="15" Fill="#252525" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Label Margin="15,0,0,0" Content="Синхронное выполнение кода" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"/>
                </Grid>
            </Grid>
            <Grid Margin="0,5,0,0" VerticalAlignment="Center" Height="50">
                <Rectangle RadiusX="15" RadiusY="15" Fill="#252525" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Label Margin="15,0,0,0" Content="Увеличенная частота обновления диалогов" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"/>
                </Grid>
            </Grid>



        </StackPanel>
    </Grid>
</Page>

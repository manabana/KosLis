<Page x:Class="KosLis.OptionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KosLis"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="OptionsPage">

    <Grid Margin="15">
        <StackPanel>
            <Grid VerticalAlignment="Center" Height="50">
                <Rectangle RadiusX="15" RadiusY="15" Fill="#252525" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Label Margin="15,0,0,0" VerticalAlignment="Center" Content="Запомнить данные для входа"/>
                    <CheckBox x:Name="LoginChecker" Grid.Column="1" HorizontalAlignment="Center" Checked="RememberData" Unchecked="ForgetData" Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"/>
                </Grid>
            </Grid>
            <Grid Margin="0,5,0,0" VerticalAlignment="Center" Height="50">
                <Rectangle RadiusX="15" RadiusY="15" Fill="#252525" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Label Margin="15,0,0,0" Content="Увеличенная частота обновления диалогов" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignSwitchDarkToggleButton}"/>
                </Grid>
            </Grid>
            <Grid Margin="0,5,0,0" VerticalAlignment="Center" Height="50">
                <Rectangle RadiusX="15" RadiusY="15" Fill="#252525" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="400"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <Label Margin="15,0,0,0" Content="Сменить пароль" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Click="ShowPasswEditor" x:Name="pencil" HorizontalAlignment="Center" Style="{StaticResource MaterialDesignToolButton}">
                        <Button.Content>
                            <Image Source="IMGs/pencil.png"/>
                        </Button.Content>
                    </Button>
                    <Button Grid.Column="2" Visibility="Collapsed" Click="SendChanges" Content="✔" Style="{StaticResource MaterialDesignToolButton}" Foreground="DarkGreen" HorizontalAlignment="Center" x:Name="ConfirmChanges"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Grid Margin="0,0,0,0" Width="175" Visibility="Collapsed" x:Name="pastpwgrid">
                            <TextBlock x:Name="tblPasswordHint" FontSize="14" Width="175" VerticalAlignment="Center" Text="Старый пароль" Foreground="DarkGray"/>
                            <PasswordBox Background="{x:Null}" TabIndex="1" KeyUp="PasswordDown" Name="pbPassword" FontSize="14" Width="175" VerticalAlignment="Center" Foreground="#F3F3F3" LostFocus="PWBFilling" Visibility="Visible" GotFocus="PWBCleaning"/>
                            <TextBox KeyUp="TextBoxDown" TabIndex="1" Name="tbPassword" FontSize="14" Width="175" VerticalAlignment="Center" Foreground="#F3F3F3" Background="{x:Null}" LostFocus="PWBFilling" GotFocus="PWBCleaning" Visibility="Collapsed"/>
                        </Grid>
                        <Button Width="35" Margin="5" Height="35" x:Name="eye" Visibility="Collapsed" Click="PWVisibilitySwitch" Background="{x:Null}" Style="{StaticResource MaterialDesignToolButton}" BorderBrush="{x:Null}">
                            <Image x:Name="PWVis" Source="IMGs/show.png" Width="25" Height="25"/>
                        </Button>

                        <Grid Margin="0,0,0,0" Width="175" Visibility="Collapsed" x:Name="nextpwgrid">
                            <TextBlock x:Name="tblPasswordHint2" FontSize="14" Width="175" VerticalAlignment="Center" Text="Новый пароль" Foreground="DarkGray"/>
                            <PasswordBox Background="{x:Null}" TabIndex="1" KeyUp="PasswordDown2" Name="pbPassword2" FontSize="14" Width="175" VerticalAlignment="Center" Foreground="#F3F3F3" LostFocus="PWBFilling2" Visibility="Visible" GotFocus="PWBCleaning2"/>
                            <TextBox KeyUp="TextBoxDown2" TabIndex="1" Name="tbPassword2" FontSize="14" Width="175" VerticalAlignment="Center" Foreground="#F3F3F3" Background="{x:Null}" LostFocus="PWBFilling2" GotFocus="PWBCleaning2" Visibility="Collapsed"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>



        </StackPanel>
    </Grid>
</Page>

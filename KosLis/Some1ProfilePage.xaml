<Page x:Class="KosLis.Some1ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KosLis"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Some1ProfilePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid>
            <Rectangle Fill="#252525">
                <Rectangle.Effect>
                    <DropShadowEffect Direction="270" ShadowDepth="2" Opacity="0.7"/>
                </Rectangle.Effect>

            </Rectangle>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignFlatButton}" Click="NavigateHome" Content="🡸" FontSize="18" Foreground="White"/>
                <Ellipse HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="Round" Stroke="White" StrokeThickness="1" Height="160" Width="160">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="IMGs/StockUsr.png" x:Name="UserPhoto" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel Grid.Column="1">
                    <Label x:Name="NicknameLBL" Margin="0,10,0,0" FontSize="16"/>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Label FontSize="16" x:Name="NML" Content="Имя:" />
                        <Label FontSize="16" x:Name="NameLBL" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Label FontSize="16" x:Name="NL" Content="Фамилия:" />
                        <Label FontSize="16" x:Name="SurnameLBL" Margin="10,0,0,0"/>
                    </StackPanel>

                </StackPanel>
            </Grid>

        </Grid>
        <Grid Grid.Row="1">
            <ListView HorizontalAlignment="Center" x:Name="FeedList" ScrollViewer.CanContentScroll="False" Background="{x:Null}" Foreground="{x:Null}" BorderBrush="{x:Null}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="PostPreview" Width="546">
                            <Rectangle RadiusX="15" RadiusY="15" Fill="#171717"/>
                            <StackPanel>
                                <StackPanel  Orientation="Vertical">
                                    <Grid>
                                        <Rectangle Fill="#242424" RadiusX="15" RadiusY="15"/>
                                        <StackPanel Margin="0,4,0,4" Width="540" Orientation="Horizontal" FlowDirection="LeftToRight">
                                            <Ellipse Width="50" Height="50">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="IMGs/StockUsr.png"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <StackPanel Orientation="Vertical" FlowDirection="LeftToRight">
                                                <Label Content="{Binding userName}" FontSize="16"/>
                                                <Label Content="{Binding postDate}" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>

                                    </Grid>
                                    <Label x:Name="PostTTL" Content="{Binding postTitle}" FontSize="20"/>
                                    <Label x:Name="PostTXT" Content="{Binding postText}" FontSize="14"/>

                                    <Grid MaxWidth="544" MaxHeight="306" Visibility="Visible" Background="Black" >
                                        <Image Source="{Binding postImage}" MaxWidth="544" MaxHeight="306"/>
                                    </Grid>
                                    <StackPanel Margin="10" Orientation="Horizontal" Visibility="Visible">
                                        <Button BorderBrush="{x:Null}" Click="Rate" Content="🡹" Tag="{Binding postId}" Foreground="White" Background="{x:Null}"/>
                                        <Label x:Name="likesOut" Content="{Binding likeCount}" Margin="10" FontSize="18" Foreground="White"/>
                                        <Button BorderBrush="{x:Null}" Click="Rate" Content="🡻" Tag="{Binding postId}" Foreground="White" Background="{x:Null}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

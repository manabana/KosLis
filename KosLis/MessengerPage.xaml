<Page x:Class="KosLis.MessengerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KosLis"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="610"
      Title="MessengerPage">

    <Grid Width="610">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Rectangle Fill="#212121" RadiusX="15" RadiusY="15"/>
        <Grid Grid.Column="0" x:Name="MessageGrid">
            <StackPanel Margin="15" Orientation="Vertical">
                <Image Visibility="Collapsed" Height="75" x:Name="MessageImage" Width="75"/>
                <TextBlock TextWrapping="Wrap" Margin="0,10,0,10" TextAlignment="Center" Visibility="Collapsed" x:Name="MessageTextBlock" Foreground="LightGray" FontSize="18"/>
                <Button Click="MessageBoxButtonClicked" IsEnabled="False" x:Name="MessageBoxButton" Foreground="White" Width="50" Background="#313131" FontSize="35" Style="{StaticResource MaterialDesignIconButton}">
                    <Button.Content>
                        <Grid>
                            <Image Visibility="Collapsed" x:Name="ReloadLBL" Source="IMGs/Refresh.png" Width="20" Height="20"/>
                            <Image Visibility="Visible" x:Name="loadLBL" Source="IMGs/Loading.png" Height="20" Width="20" >
                                <Image.RenderTransform>
                                    <RotateTransform 
                                         x:Name="rotate"
                                         CenterX="10"
                                         CenterY="10"
                                    />
                                </Image.RenderTransform>
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="rotate"
                                     Storyboard.TargetProperty="Angle"
                                     By="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>

                        </Grid>
                    </Button.Content>
                </Button>

            </StackPanel>
        </Grid>
        <ListView HorizontalAlignment="Center" Grid.Row="0" x:Name="UserListView" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" Background="{x:Null}" Foreground="{x:Null}" BorderBrush="{x:Null}" Visibility="Visible">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalAlignment="Center" Height="60" Width="200">
                        <Rectangle Fill="#2F2F2F" RadiusX="15" RadiusY="15"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Margin="10,0,0,0" Width="50" Height="50" >
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="IMGs/StockUsr.png"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Label Margin="10,0,0,0" FontSize="16" Content="{Binding Nickname}"/>
                        </StackPanel>
                        <Button Click="MesDialogOpen" Background="{x:Null}" Tag="{Binding Id}" BorderThickness="0"  Height="60" Width="200"/>

                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Margin="5,0,0,0" Grid.Column="1" Visibility="Collapsed" x:Name="MessengerGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <Rectangle Fill="#151515" RadiusX="15" RadiusY="15" Grid.RowSpan="3"/>
            <ListView ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  Background="{x:Null}" Foreground="{x:Null}" BorderBrush="{x:Null}" HorizontalAlignment="Center" Grid.Row="1" x:Name="MsgLV">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid Width="350">
                                <Grid HorizontalAlignment="{Binding alignment}" MaxWidth="200">
                                    <Rectangle Fill="#282828" RadiusX="15" RadiusY="15"/>
                                    <TextBlock TextWrapping="Wrap" Margin="10" Text="{Binding MessageText}" FontSize="14" HorizontalAlignment="Center" Foreground="White"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Visibility="Collapsed" x:Name="TopPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#282828" Grid.ColumnSpan="2">
                    <Rectangle.Effect>
                        <DropShadowEffect Direction="270" ShadowDepth="2" Opacity="0.7"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Button x:Name="ToProfileBT" Click="OpenSome1Profile"/>
                <Ellipse StrokeThickness="0" Width="32" Height="32">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="IMGs/StockUsr.png"/>
                    </Ellipse.Fill>
                </Ellipse>
                <Label Grid.Column="1" FontSize="16" x:Name="usernameOut" HorizontalAlignment="Center"/>
            </Grid>
            <Grid Height="35" Visibility="Visible" Grid.Row="2" x:Name="MessageSender">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="35"/>
                </Grid.ColumnDefinitions>
                <Rectangle Fill="#282828" RadiusX="15" RadiusY="15"/>
                <TextBox x:Name="SendingMessage" TextChanged="SendButtonLocker" VerticalAlignment="Center" CaretBrush="LightGray" Foreground="LightGray" Style="{x:Null}" Background="{x:Null}" BorderThickness="0" FontSize="16" Margin="10,0,10,0"/>
                <Button IsEnabled="False" x:Name="SendMesBT" Click="SendMessage" Height="35" Width="35" Grid.Column="1" Style="{StaticResource MaterialDesignIconButton}">
                    <Image Source="IMGs/Send.png"/>
                </Button>
            </Grid>
            
        </Grid>
    </Grid>
</Page>

<Page x:Class="KosLis.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KosLis"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="625"
      Title="ProfilePage" VerticalAlignment="Top">

    <Grid Width="600" MinHeight="450">
        <Grid x:Name="TopGrid">
            <ScrollViewer>
                <Grid>
                    <StackPanel>
                        <Grid Height="380">
                            <Rectangle RadiusX="15" RadiusY="15" Fill="#232323"/>

                            <StackPanel Orientation="Vertical">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1" HorizontalAlignment="Center" x:Name="ProfilePhoto" VerticalAlignment="Center" MouseEnter="AnimationIn" MouseLeave="AnimationOut" Height="165" Width="165">
                                        <Ellipse HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="Round" Stroke="White" StrokeThickness="1" Height="165" Width="165">
                                            <Ellipse.Fill>
                                                <ImageBrush x:Name="PP" ImageSource="IMGs/StockUsr.png" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse x:Name="rndAnim" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="White" StrokeThickness="1" Height="165" Width="165">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="IMGs/graypencil.png" Stretch="UniformToFill"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Button MouseEnter="ToProfileIn" MouseLeave="ToProfileOut" Click="ToProfileBT" Height="165" Width="165">
                                            <Button.Template>
                                                <ControlTemplate  TargetType="Button">
                                                    <Grid>
                                                        <Ellipse Height="165" Width="165" Fill="Black" Opacity="0"/>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </Grid>


                                </Grid>
                                <StackPanel Margin="20,15,0,0" Orientation="Horizontal">
                                    <Label FontSize="16" Content="E-mail:"/>
                                    <Label FontSize="16" x:Name="EMailTB"/>
                                    <TextBox Foreground="White" FontSize="16" x:Name="EmailEditor" Visibility="Collapsed"/>
                                    <Button x:Name="EmailEditBT" Click="EditEmail" Height="29" Width="29" Style="{StaticResource MaterialDesignToolButton}" Cursor="Hand">
                                        <Button.Content>
                                            <Image Source="IMGs/pencil.png"/>
                                        </Button.Content>
                                    </Button>
                                    <Button x:Name="ConfirmEmailEdit" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Content="✔" Foreground="DarkGreen" FontSize="16" Click="ApplyEmail"/>
                                    <Button Click="UndoClicked" x:Name="UndoEmailEdit" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Content="❌" Foreground="DarkRed" FontSize="16"/>
                                </StackPanel>
                                <StackPanel Margin="20,15,0,0" Orientation="Horizontal">
                                    <Label FontSize="16" Content="Имя пользователя:"/>
                                    <Label FontSize="16" x:Name="NicknameTB"/>
                                    <TextBox Foreground="White" FontSize="16" x:Name="NicknameEditor" Visibility="Collapsed"/>
                                    <Button x:Name="NicknameEditBT" Click="EditNickname" Height="29" Width="29" Style="{StaticResource MaterialDesignToolButton}" Cursor="Hand">
                                        <Button.Content>
                                            <Image Source="IMGs/pencil.png"/>
                                        </Button.Content>
                                    </Button>
                                    <Button x:Name="ConfirmNicknameEdit" Click="NicknameConfirm" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Content="✔" Foreground="DarkGreen" FontSize="16"/>
                                    <Button Click="UndoClicked" x:Name="UndoNicknameEdit" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Content="❌" Foreground="DarkRed" FontSize="16"/>

                                </StackPanel>
                                <StackPanel Margin="20,15,0,0" Orientation="Horizontal">
                                    <Label FontSize="16" Content="Имя:"/>
                                    <Label FontSize="16" x:Name="NameTB"/>
                                    <TextBox Foreground="White" FontSize="16" x:Name="NameEditor" Visibility="Collapsed"/>
                                    <Button x:Name="NameEditBT" Click="EditName"  Height="29" Width="29" Style="{StaticResource MaterialDesignToolButton}" Cursor="Hand">
                                        <Button.Content>
                                            <Image Source="IMGs/pencil.png"/>
                                        </Button.Content>
                                    </Button>
                                    <Button x:Name="ConfirmNameEdit" Click="NameConfirm" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Content="✔" Foreground="DarkGreen" FontSize="16"/>
                                    <Button Click="UndoClicked" x:Name="UndoNameEdit" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Content="❌" Foreground="DarkRed" FontSize="16"/>


                                </StackPanel>
                                <StackPanel Margin="20,15,0,0" Orientation="Horizontal">
                                    <Label FontSize="16" Content="Фамилия:"/>
                                    <Label FontSize="16" x:Name="SurnameTB"/>
                                    <TextBox Foreground="White" FontSize="16" x:Name="SurnameEditor" Visibility="Collapsed"/>

                                    <Button x:Name="SurnameEditBT" Click="EditSurname" Height="29" Width="29" Style="{StaticResource MaterialDesignToolButton}" Cursor="Hand">
                                        <Button.Content>
                                            <Image Source="IMGs/pencil.png"/>
                                        </Button.Content>
                                    </Button>
                                    <Button x:Name="ConfirmSurnameEdit" Click="SurnameConfirm" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Content="✔" Foreground="DarkGreen" FontSize="16"/>
                                    <Button Click="UndoClicked" x:Name="UndoSurnameEdit" Visibility="Collapsed" Style="{StaticResource MaterialDesignToolButton}" Content="❌" Foreground="DarkRed" FontSize="16"/>

                                </StackPanel>
                            </StackPanel>

                        </Grid>
                        <Grid Height="40" Width="546" Margin="0,15,0,0">
                            <Rectangle Fill="#232323" RadiusX="15" RadiusY="15"/>
                            <Label HorizontalAlignment="Center" Content="Мои посты" FontSize="16" VerticalAlignment="Center" />
                        </Grid>
                        <Grid Margin="0,0,0,0">
                            <ListView HorizontalAlignment="Center" x:Name="FeedList" ScrollViewer.CanContentScroll="False" Background="{x:Null}" Foreground="{x:Null}" BorderBrush="{x:Null}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="PostPreview" Width="546">
                                            <Rectangle RadiusX="15" RadiusY="15" Fill="#171717"/>
                                            <StackPanel>
                                                <StackPanel  Orientation="Vertical">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="40"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Rectangle Grid.ColumnSpan="2" Fill="#242424" RadiusX="15" RadiusY="15"/>
                                                        <StackPanel Margin="5" Width="540" Orientation="Horizontal" FlowDirection="LeftToRight">
                                                            <Ellipse Width="50" Height="50">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding profilePhoto}"/>
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <StackPanel Orientation="Vertical" FlowDirection="LeftToRight">
                                                                <Label Content="{Binding userName}" FontSize="16"/>
                                                                <Label Content="{Binding postDate}" FontSize="12"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Height="40" Width="40" x:Name="DeletePostBT" Click="DeletePost" Tag="{Binding postId}" Style="{StaticResource MaterialDesignIconButton}">
                                                            <Button.Content>
                                                                <Image Height="30" Width="30" Source="IMGs/delete.png"/>
                                                            </Button.Content>
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Margin="5" x:Name="PostTTL" TextWrapping="Wrap" Foreground="White" Text="{Binding postTitle}" FontSize="20"/>
                                                    <TextBlock Margin="5" x:Name="PostTXT" TextWrapping="Wrap" Text="{Binding postText}" Foreground="White" FontSize="14"/>

                                                    <Grid MaxWidth="544" MaxHeight="306" Visibility="Visible" Background="Black" >
                                                        <Image Source="{Binding postImage}" MaxWidth="544" MaxHeight="306"/>
                                                    </Grid>
                                                    <StackPanel Margin="10" Orientation="Horizontal" Visibility="Visible">
                                                        <Button BorderBrush="{x:Null}" Click="Rate" Content="🡹" Tag="{Binding postId}" Foreground="White" Background="{x:Null}"/>
                                                        <Label x:Name="likesOut" Content="{Binding likeCount}" Margin="10" FontSize="18" Foreground="White"/>
                                                        <Button BorderBrush="{x:Null}" Click="Rate" Content="🡻" Tag="{Binding postId}" Foreground="White" Background="{x:Null}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Rectangle Fill="{x:Null}" StrokeThickness="0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

        </Grid>
        <Grid Height="440" Width="590" Visibility="Collapsed" Opacity="0" x:Name="PPSelectorGrid" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Rectangle Fill="#2f2f2f" RadiusX="15" RadiusY="15"/>
            <Button VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource MaterialDesignFlatButton}" Click="NavigateBack" Content="🡸" FontSize="18" Foreground="White"/>

            <Label Content="Выберите фото профиля" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
            <Grid x:Name="ImageContainer" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Rectangle Fill="#181818" RadiusX="15" RadiusY="15" Grid.RowSpan="2" Grid.ColumnSpan="5"/>
                <Grid>
                    <Image Width="100" x:Name="Image1" Tag="Image1" Height="100" Source="IMGs/PPs/1.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check1" Tag="Check1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="1" Click="PhotoSelected" x:Name="But1" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Image Width="100" x:Name="Image2" Tag="Image2" Height="100" Source="IMGs/PPs/2.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check2" Tag="Check2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="2" Click="PhotoSelected" x:Name="But2" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>
                <Grid Grid.Column="2">
                    <Image Width="100" x:Name="Image3" Tag="Image3" Height="100" Source="IMGs/PPs/3.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check3" Tag="Check3" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="3" Click="PhotoSelected" x:Name="But3" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>
                <Grid Grid.Column="3">
                    <Image Width="100" x:Name="Image4" Tag="Image4" Height="100" Source="IMGs/PPs/4.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check4" Tag="Check4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="4" Click="PhotoSelected" x:Name="But4" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>
                <Grid Grid.Column="4">
                    <Image Width="100" x:Name="Image5" Tag="Image5" Height="100" Source="IMGs/PPs/5.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check5" Tag="Check5" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="5" Click="PhotoSelected" x:Name="But5" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>
                <Grid Grid.Row="1">
                    <Image Width="100" x:Name="Image6" Tag="Image6" Height="100" Source="IMGs/PPs/6.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check6" Tag="Check6" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="6" Click="PhotoSelected" x:Name="But6" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>
                <Grid Grid.Column="1" Grid.Row="1">
                    <Image Width="100" x:Name="Image7" Tag="Image7" Height="100" Source="IMGs/PPs/7.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check7" Tag="Check7" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="7" Click="PhotoSelected" x:Name="But7" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>
                <Grid Grid.Row="1" Grid.Column="2">
                    <Image Width="100" x:Name="Image8" Tag="Image8" Height="100" Source="IMGs/PPs/8.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check8" Tag="Check8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="8" Click="PhotoSelected" x:Name="But8" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>
                <Grid Grid.Column="3" Grid.Row="1">
                    <Image Width="100" x:Name="Image9" Tag="Image9" Height="100" Source="IMGs/PPs/9.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check9" Tag="Check9" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="9" Click="PhotoSelected" x:Name="But9" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>
                <Grid Grid.Row="1" Grid.Column="4">
                    <Image Width="100" x:Name="Image10" Tag="Image10" Height="100" Source="IMGs/PPs/10.jpg">
                        <Image.Clip>
                            <EllipseGeometry Center="50,50" RadiusX="50" RadiusY="50" />
                        </Image.Clip>
                    </Image>
                    <Label Content="✔" Visibility="Collapsed" x:Name="Check10" Tag="Check10" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" Foreground="Green"/>
                    <Button Width="100" Tag="10" Click="PhotoSelected" x:Name="But10" Height="100" Style="{StaticResource MaterialDesignToolButton}" Background="{x:Null}" BorderThickness="0"/>

                </Grid>

            </Grid>
        </Grid>
        <Grid Visibility="Collapsed" Opacity="0" x:Name="MessageGrid" Grid.RowSpan="2">
            <Grid MinHeight="100" MaxHeight="200" Width="400" Margin="0,80,0,0" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Rectangle Grid.RowSpan="2" Fill="#242424"  RadiusX="15" RadiusY="15"/>
                <Grid Grid.Row="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Click="ButClicked" Height="25" Width="80" x:Name="Button1" Background="#FF290A5F" BorderBrush="#FF290A5F"/>
                        <Button Click="ButClicked" Width="80" Height="25" x:Name="Button2" Margin="50,0,0,0" BorderBrush="#FF290A5F" Background="#FF290A5F"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="MessageIcon" MinWidth="30" MaxHeight="60" MaxWidth="60" MinHeight="30" Source="IMGs/UnkErr.png"/>
                    <TextBlock x:Name="MessageText" Margin="0,0,10,0" Grid.Column="1" Text="" FontSize="16" TextWrapping="Wrap" Foreground="White" HorizontalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Page>
